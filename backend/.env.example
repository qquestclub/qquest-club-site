# Copy to backend/.env for local use if you like (it is gitignored), or export these in
# your shell. Never commit the filled-in version. Real values go in the host's settings.

# Local development: turns on debug and a throwaway secret key.
DJANGO_DEBUG=1

# Production only (set these in Render, never in a file):
# DJANGO_SECRET_KEY=        a long random string: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DATABASE_URL=             the Neon connection string (postgresql://...). Leave unset locally to use SQLite.
# DJANGO_ALLOWED_HOSTS=     api.example.org (Render adds its own hostname automatically)
# CORS_ALLOWED_ORIGINS=     https://your-site.example (the website, no trailing slash, comma-separated)
# CSRF_TRUSTED_ORIGINS=     https://your-api-host.example (needed for the /admin/ login)
